DISCORD_BOT_TOKEN=your_discord_bot_token
KURO_OWNER_USER_ID="your_owner_user_id"
# Nur für den OpenAI-Betrieb (kein "llm"-Bereich in der config.json):
OPENAI_API_KEY=your_openai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
KURO_VOICE_ID=your_voice_id
# Optional, falls eigene LLM-/STT-/TTS-Endpunkte einen Schlüssel verlangen:
KURO_LLM_API_KEY=
KURO_STT_API_KEY=
KURO_TTS_API_KEY=
